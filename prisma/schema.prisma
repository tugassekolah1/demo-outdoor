// ============================================================
// Prisma Schema — TAPAK Outdoor Rental (Demo)
// PHASE 2: Schema database asli.
// ============================================================
//
// CATATAN PENTING soal enum & SQLite:
// SQLite tidak mendukung tipe `enum` native di Prisma (beda dengan
// PostgreSQL/MySQL). Karena itu field seperti `Booking.status` dan
// `User.role` disimpan sebagai `String`, tapi nilainya dibatasi lewat
// TypeScript union type di `types/index.ts` (dibuat di langkah
// berikutnya pada phase ini) dan divalidasi di level aplikasi (API
// route handler) saat Phase 7 & 11 dikerjakan. Ini pola umum yang
// dipakai banyak project Prisma + SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// User — akun admin yang login ke panel admin.
// Untuk demo ini hanya dipakai untuk admin (role default "admin").
// Autentikasi asli (hash password, session) dikerjakan di Phase 9.
// ------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // disimpan sebagai hash, bukan plain text (implementasi Phase 9)
  role      String   @default("admin") // nilai yang dipakai: "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// Category — kategori produk rental (Tenda, Carrier, dll).
// ------------------------------------------------------------
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

// ------------------------------------------------------------
// Product — barang yang disewakan.
// ------------------------------------------------------------
model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  pricePerDay  Int // harga sewa per hari, dalam Rupiah (bukan desimal)
  stock        Int           @default(0)
  image        String? // path/URL gambar produk, opsional untuk demo

  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])

  bookingItems BookingItem[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
}

// ------------------------------------------------------------
// Booking — satu transaksi booking dari customer.
// status yang valid (dijaga di level aplikasi, lihat catatan di atas):
//   "PENDING" | "CONFIRMED" | "ONGOING" | "COMPLETED" | "CANCELLED"
// ------------------------------------------------------------
model Booking {
  id           String        @id @default(cuid())
  customerName String
  whatsapp     String
  startDate    DateTime
  endDate      DateTime
  note         String? // catatan tambahan dari customer, opsional
  status       String        @default("PENDING")
  totalPrice   Int // total = Σ (quantity × price × jumlah hari sewa)

  items        BookingItem[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

// ------------------------------------------------------------
// BookingItem — baris item di dalam satu booking (relasi many-to-many
// antara Booking dan Product, dengan data tambahan quantity & price).
// `price` di-snapshot dari Product.pricePerDay pada saat booking dibuat,
// supaya histori booking tidak berubah walau harga produk diubah admin
// nanti.
// ------------------------------------------------------------
model BookingItem {
  id        String   @id @default(cuid())

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int
  price     Int // snapshot Product.pricePerDay saat booking dibuat (per hari)
  subtotal  Int // quantity × price × jumlah hari sewa

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([productId])
}
