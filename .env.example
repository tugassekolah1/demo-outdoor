# Salin file ini menjadi ".env" lalu sesuaikan jika perlu.

# Lokasi database SQLite untuk development.
DATABASE_URL="file:./dev.db"

# ============================================================
# Auth admin (Phase 9)
# ============================================================
# Credential login panel admin (/admin/login).
# Jika ADMIN_EMAIL & ADMIN_PASSWORD keduanya diisi, login memakai
# nilai ini (cara termudah untuk demo — tidak perlu sentuh database).
# Jika kosong, sistem fallback ke akun di tabel `User`
# (password disimpan sebagai hash PBKDF2, bukan plain text).
ADMIN_EMAIL="admin@tapak.local"
ADMIN_PASSWORD="admin12345"

# Secret untuk menandatangani session cookie admin.
# Ganti dengan string acak panjang di production
# (mis. hasil `openssl rand -hex 32`).
AUTH_SECRET="tapak-ganti-dengan-secret-acak-panjang"

# ============================================================
# WhatsApp (Phase 8 lanjutan)
# ============================================================
# Nomor WhatsApp admin PENERIMA pesan konfirmasi booking.
# Format internasional tanpa "+"/spasi, awali kode negara (62).
# Awalan "0" otomatis dikonversi ke "62".
# Kosongkan jika tombol "Kirim ke WhatsApp Admin" ingin dinonaktifkan.
WHATSAPP_ADMIN_NUMBER="6281234567890"
